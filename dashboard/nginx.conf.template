server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    # Proxy /api to the backend service.
    # Using a VARIABLE (+ resolver) instead of a literal upstream so nginx does
    # NOT resolve the hostname at boot — that literal-resolution is what crashed
    # startup with "host not found in upstream". Now nginx starts regardless and
    # resolves BACKEND_HOST at request time.
    # Set BACKEND_HOST (Railway → Variables) to the backend's private address,
    # e.g.  dashboard-backend.railway.internal:8002
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $backend "${BACKEND_HOST}";
        proxy_pass http://$backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # React SPA — all other routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
