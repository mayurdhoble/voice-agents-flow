# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vobiz Credentials
# Get from: https://console.vobiz.ai
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_PHONE_NUMBER=+91
# Server Configuration
HOST=0.0.0.0
PORT=8000

# Public URL for Vobiz webhooks (use ngrok for local dev)
# Example: https://abc123.ngrok.io
PUBLIC_URL=https://your-public-url.com

# Hotel Configuration
HOTEL_NAME=The Royal Palace Hotel
HOTEL_CITY=Mumbai
AGENT_NAME=Priya
