server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    # Proxy /api to the CLIENT backend service (client_main.py, port 8003).
    # Variable + resolver so nginx starts even if the backend name is briefly
    # unresolvable (no boot-time "host not found in upstream" crash).
    # Set BACKEND_HOST (Railway → Variables) to the client backend's private
    # address, e.g.  client-backend.railway.internal:8003
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $backend "${BACKEND_HOST}";
        proxy_pass http://$backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # React SPA — all other routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
